.venv/
__pycache__/
*.pyc
.env
# .env 的各种变体(备份、按环境分的副本)同样含真实密钥,必须一起挡住。
# 只放行 .env.example —— 它是对外发布的模板,里面只有占位符。
.env.*
!.env.example
.pytest_cache/
# 测试与运行时留下的临时目录:pytest 的 basetemp(pytest-of-<user>/)与 TorchInductor 编译缓存
# (torchinductor_<user>/)会落在当时的工作目录。临时壳里跑一次就可能出现,git add -A 不许扫进来。
pytest-of-*/
torchinductor_*/
.superpowers/
data/*.db*
data/*.sqlite*
dev-notes/
log/
logs/
*.pid
data/ch10/*
!data/ch10/reports

# 运行日志:后台页发起的作业与 dev.sh 启动日志,本地产物不入库
data/*.log
data/ch04/*.log
