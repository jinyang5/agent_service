# 聊天上游(DeepSeek 官方,OpenAI 兼容协议)
# CHAT_MODEL 必须是 DeepSeek 平台里可用的真实模型名。2026-07 起 deepseek-chat/reasoner 已退役,
# 用 deepseek-v4-flash(快)或 deepseek-v4-pro(强),以你平台控制台显示为准。
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=sk-xxx

TOKEN_BUDGET=2000

# 嵌入:BGE-M3 在【进程内】本地加载,无需 key;首次加载从 HuggingFace 下 ~2GB
# 国内慢/被墙时打开镜像(取消下面一行注释再启动):
# HF_ENDPOINT=https://hf-mirror.com
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# 向量库:Milvus Standalone(Docker, 19530)
MILVUS_URI=http://localhost:19530

# 检索:dense 单路 Top-K 与最低命中分(COSINE 相似度,越小越松)
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.4

# MySQL(ch02 容器:宿主机 3307 → 容器 3306;本机 3306 被 MySQL97 占用,故用 3307)
DATABASE_URL=mysql+asyncmy://root:root@localhost:3307/mewhelp
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3307/mewhelp_ch03_test
